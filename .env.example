# Required. https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# Written by `manage.py publish_agent` — the agent the voice page connects to.
AGENT_ID=

# Public https origin of this deployment. AssemblyAI posts log_claim to
# <PUBLIC_BASE_URL>/api/log-claim/, so without it the tool is not published at
# all. Locally, run ./run.sh to get a tunnel URL automatically.
PUBLIC_BASE_URL=

# Optional. When set, the webhook requires this value in X-Claim-Secret and
# the published tool sends it.
CLAIM_WEBHOOK_SECRET=

# Django
DEBUG=True
# Desk pages (dashboard, insights, directory) sit behind a password when this
# is on. Defaults to on whenever DEBUG is off.
# DESK_AUTH=1
# DESK_PASSWORD=

# Lets the Talk-to-Ivy page show one policyholder's number and the last four
# digits, so a tester has credentials to read out. Those digits are the secret
# the agent verifies identity against, so this is off unless you ask for it,
# and even then it only ever answers for a single policy looked up by name.
# DEMO_CREDENTIALS=1
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
# DATABASE_URL=postgres://...

# --- phone number (optional) ------------------------------------------------
# For `manage.py connect_phone`. Twilio hands inbound calls to AssemblyAI over
# SIP, so there is no media server to run.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # a number you already own, E.164: +15551234567
TWILIO_TRUNK_DOMAIN=          # you pick this, must end .pstn.twilio.com
# The same credentials send the claim-reference SMS after log_claim.

# Desk login. On automatically when DEBUG=False. Voice and /c/ stay public.
# DESK_AUTH=1
# DESK_PASSWORD=claimvoice

# Optional email after log_claim when the policyholder has an address.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=ClaimVoice <noreply@localhost>
